# Nexus Platform Web Environment Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration (Public keys - safe for frontend)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry Configuration (Public DSN - safe for frontend)
VITE_SENTRY_DSN=https://your_sentry_dsn_here

# Cloudflare Turnstile (Public site key - safe for frontend)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
