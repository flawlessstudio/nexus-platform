{
  "name": "nexus-platform",
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "web",
    "backend"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --parallel build",
    "lint": "pnpm -r --parallel lint",
    "doctor": "node tools/readiness_doctor.mjs || true",
    "doctor:ci": "CI=true node tools/readiness_doctor.mjs --open=false || true",
    "test": "echo \"No tests yet\"",
    "sanity": "node tools/sanity_check.mjs",
    "sanity:strict": "node tools/sanity_check.mjs --strict"
  }
}
